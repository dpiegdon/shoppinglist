#!/bin/sh -e

# Idempotent installation script for gittoc system into repositories.
# Run from the project root.
#  - Removes dev-only files (.git, AGENTS.md, scripts/dev pipeline) not needed by installs.
#  - Sets up `git toc` alias.
#  - Sets up skill symlinks and git alias for a vendored gittoc install.
#  - Optionally enables autopush mode.
#  - Initializes a new gittoc ticket system if none exists yet.
#
# Options:
#   --autopush    enable auto-push/pull on every mutating command
#                 (git config gittoc.autopush true)

GITTOC_DIR="$(cd "$(dirname "$0")/../" && pwd -P)"

# Resolve the host repository from the gittoc directory's *parent*, not from
# the caller's cwd: a freshly cloned vendored copy still carries its own .git,
# which would otherwise shadow the host when setup is run from inside it.
if ! GIT_ROOTDIR="$(git -C "$GITTOC_DIR/.." rev-parse --show-toplevel 2>/dev/null)"; then
	echo "error: $GITTOC_DIR is not inside a git repository; vendor gittoc into the host repo first" >&2
	exit 1
fi

# Refuse to strip a development checkout. A vendored clone is pristine: one
# local branch, clean tree, no stash. A checkout someone works in has a local
# 'gittoc' tracker branch, extra branches, uncommitted changes or stashes, and
# deleting its .git would destroy that work.
if [ "$(git -C "$GITTOC_DIR" rev-parse --show-toplevel 2>/dev/null)" = "$GITTOC_DIR" ]; then
	if git -C "$GITTOC_DIR" show-ref --verify --quiet refs/heads/gittoc \
		|| [ -n "$(git -C "$GITTOC_DIR" status --porcelain 2>/dev/null)" ] \
		|| [ "$(git -C "$GITTOC_DIR" branch --list 2>/dev/null | grep -c .)" -gt 1 ] \
		|| [ -n "$(git -C "$GITTOC_DIR" stash list 2>/dev/null)" ]; then
		echo "error: $GITTOC_DIR looks like a development checkout (local branches, uncommitted changes or stashes)" >&2
		echo "       refusing to delete its .git; setup is for pristine vendored clones" >&2
		exit 1
	fi
fi

# Both paths are physical (pwd -P / rev-parse) and GITTOC_DIR is below
# GIT_ROOTDIR, so plain POSIX prefix stripping gives the relative path
# without GNU-only `realpath --relative-to` (absent on macOS/BSD).
GITTOC_DIR_REL="${GITTOC_DIR#"$GIT_ROOTDIR"/}"

# remove unneeded files that may befuddle agents or users
# (scripts/dev is the dev-only lint/test pipeline + its venv; installs don't need it)
for F in AGENTS.md .git assets/gittoc_logo.png scripts/dev .isort.cfg; do
	if [ -e "$GITTOC_DIR/$F" ]; then
		rm -Rf "$GITTOC_DIR/$F"
	fi
done

# create `git toc` alias
git config alias.toc >/dev/null 2>&1 || git config alias.toc "!./$GITTOC_DIR_REL/scripts/gittoc"

# enable autopush mode if desired (--autopush)
AUTOPUSH=0
for arg in "$@"; do
    case "$arg" in
        --autopush) AUTOPUSH=1 ;;
    esac
done
if [ "$AUTOPUSH" = "1" ]; then
    git config gittoc.autopush true
    echo "auto-push enabled (gittoc.autopush=true)"
fi

# create agentic-specific symlinks to skill
for AGENT in claude github openai opencode; do
	SKILLDIR="$GIT_ROOTDIR/.${AGENT}/skills"
	if [ ! -e "$SKILLDIR/gittoc" ]; then
		mkdir -p "$SKILLDIR"
		ln -s "../../$GITTOC_DIR_REL" "$SKILLDIR/gittoc"
	fi
done

# initialize gittoc system
git toc init

# a skill only fires when an agent judges it relevant; an always-loaded
# instruction file makes the tracker mandatory
cat <<STANZA

gittoc is installed. Add this to the AGENTS.md / CLAUDE.md of this repository so
agents use the tracker for all planning and tracking:

    Use gittoc ('git toc'; skill in $GITTOC_DIR_REL/SKILL.md) for all task
    tracking and planning instead of chat-only plans. Set GITTOC_OWNER to your
    agent name before any mutating command.

STANZA
