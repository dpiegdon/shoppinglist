        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="3"
                android:startY="3"
                android:endX="45"
                android:endY="45"
                android:startColor="#863BFF"
                android:endColor="#47BFFF" />
        </aapt:attr>
    </path>
    <path
        android:fillColor="#FFFFFFFF"
