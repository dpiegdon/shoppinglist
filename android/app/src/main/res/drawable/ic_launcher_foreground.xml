<!-- Adaptive-icon foreground (T-216): the Tuppu mark centred in the 108dp canvas. A launcher may
     mask the icon to a circle of 66dp, and a square slab reaches that circle at its corners
     before its edges do, so the 42-unit slab is scaled 1.15x (48.3dp, corners at about 32dp
     from the centre) rather than filling the zone. Background is @color/ic_launcher_background.
     Same gradient as ic_brand_logo.xml: its coordinates live in the path's own space, so the
     group's scale and translate carry it along with the path. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.15"
        android:scaleY="1.15"
        android:translateX="26.4"
        android:translateY="26.4">
        <path android:pathData="M9 3H41C43.2 3 45 4.8 45 7V38C45 41.9 41.9 45 38 45H6C4.3 45 3 43.7 3 42V9C3 5.7 5.7 3 9 3Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="3"
                    android:startY="3"
                    android:endX="45"
                    android:endY="45"
                    android:startColor="#863BFF"
                    android:endColor="#47BFFF" />
            </aapt:attr>
        </path>
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M11 10.8L18 14L11 17.2ZM16 12.9L37 13.45L37 14.55L16 15.1ZM11 20.8L18 24L11 27.2ZM16 22.9L30 23.45L30 24.55L16 25.1ZM11 30.8L18 34L11 37.2ZM16 32.9L34 33.45L34 34.55L16 35.1Z" />
    </group>
</vector>
